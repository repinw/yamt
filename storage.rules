rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Membership: the member entry of the user exists in the household.
    function isHouseholdMember(householdId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/households/$(householdId)/members/$(request.auth.uid)
        );
    }

    function isKitchenUtensilImage() {
      return request.resource == null
        || (
          request.resource.size < 2 * 1024 * 1024
          && request.resource.contentType.matches('image/.*')
        );
    }

    match /households/{householdId}/kitchen_utensils/{utensilId}/images/{imageId} {
      allow read, delete: if isHouseholdMember(householdId);
      allow create, update: if isHouseholdMember(householdId)
        && isKitchenUtensilImage();
    }

    // A member lists the household images to delete them with the household
    // or after a fresh start.
    match /households/{householdId}/{folder}/{allPaths=**} {
      allow list: if isHouseholdMember(householdId)
        && folder in ['kitchen_utensils', 'recipes'];
    }

    function isRecipeImage() {
      return request.resource == null
        || (
          request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*')
        );
    }

    match /households/{householdId}/recipes/{mealId}/images/{imageId} {
      allow read, delete: if isHouseholdMember(householdId);
      allow create, update: if isHouseholdMember(householdId)
        && isRecipeImage();
    }

    function isProductImage() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // The user's own food photos, such as the plate photo of an AI food
    // estimate. They are the image of the user's item and are never shared
    // as a product image.
    match /users/{uid}/food_photos/{fileName} {
      allow read, delete: if canAccessHouseholdOwnedData(uid);
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isProductImage();
      allow update: if false;
    }

    // Package photos from the product editor. Every signed-in user sees
    // them as shared product images. Only the uploader writes into their
    // own folder, and nobody changes or deletes a photo from the app, so a
    // later review can rely on them.
    match /product_images/{uid}/{photoId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isProductImage();
      allow update, delete: if false;
    }
  }
}
