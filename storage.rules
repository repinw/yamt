rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userExists(uid) {
      return firestore.exists(
        /databases/(default)/documents/users/$(uid)
      );
    }

    function userHouseholdId(uid) {
      return userExists(uid)
        && firestore.get(/databases/(default)/documents/users/$(uid))
          .data.householdId is string
        ? firestore.get(/databases/(default)/documents/users/$(uid))
            .data.householdId
        : null;
    }

    function householdOwnerId(uid) {
      let householdId = userHouseholdId(uid);
      return householdId == null ? uid : householdId;
    }

    function currentHouseholdOwnerId() {
      return householdOwnerId(request.auth.uid);
    }

    function canAccessHouseholdOwnedData(uid) {
      return isSignedIn()
        && (
          request.auth.uid == uid
          || currentHouseholdOwnerId() == uid
        );
    }

    function isKitchenUtensilImage() {
      return request.resource == null
        || (
          request.resource.size < 2 * 1024 * 1024
          && request.resource.contentType.matches('image/.*')
        );
    }

    match /users/{uid}/kitchen_utensils/{utensilId}/images/{imageId} {
      allow read, delete: if canAccessHouseholdOwnedData(uid);
      allow create, update: if canAccessHouseholdOwnedData(uid)
        && isKitchenUtensilImage();
    }

    function isRecipeImage() {
      return request.resource == null
        || (
          request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*')
        );
    }

    match /users/{uid}/recipes/{mealId}/images/{imageId} {
      allow read, delete: if canAccessHouseholdOwnedData(uid);
      allow create, update: if canAccessHouseholdOwnedData(uid)
        && isRecipeImage();
    }

    function isProductImage() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Package photos from the product editor. Every signed-in user sees
    // them as shared product images. Only the uploader writes into their
    // own folder, and nobody changes or deletes a photo from the app, so a
    // later review can rely on them.
    match /product_images/{uid}/{photoId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isProductImage();
      allow update, delete: if false;
    }
  }
}
