rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerifiedAccount() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function memberPath(householdId, uid) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
    }

    // Membership: the member entry of the user exists in the household.
    function isHouseholdMember(householdId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // The user is a member once this request is written, for example when
    // joining writes the member entry and the key entry together.
    function isHouseholdMemberAfter(householdId) {
      return isSignedIn()
        && existsAfter(memberPath(householdId, request.auth.uid));
    }

    function isHouseholdAdmin(householdId) {
      return isHouseholdMember(householdId)
        && get(memberPath(householdId, request.auth.uid)).data.role == 'admin';
    }

    // The reader and [uid] are both members of the household that the
    // reader's profile names as active.
    function isActiveCoMember(uid) {
      let householdId = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('householdId', null);
      return householdId is string
        && isHouseholdMember(householdId)
        && exists(memberPath(householdId, uid));
    }

    function canReadUserDocument(uid) {
      return isOwner(uid) || (isSignedIn() && isActiveCoMember(uid));
    }

    function invitePath(code) {
      return /databases/$(database)/documents/household_invites/$(code);
    }

    function isValidInvite(code, householdId) {
      let invite = get(invitePath(code));
      return invite.data.keys().hasOnly([
          'householdId',
          'expiresAt',
          'wrapped_household_key',
        ])
        && invite.data.householdId == householdId
        && invite.data.expiresAt > request.time;
    }

    // Households and their invites have their own rules. The generic rule at
    // the end must not open them for a document that only carries a userId
    // field: a forged invite would let anybody join any household.
    function isOutsideHouseholds(path) {
      return !(path[0] in ['households', 'household_invites']);
    }

    function isOptionalString(data, key) {
      return !(key in data) || data[key] == null || data[key] is string;
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    // Private documents hold only a payload that the data key of the user
    // encrypts, plus the plaintext fields that queries need.
    function isEncryptedDocument(data, plaintextKeys) {
      return data.keys().hasOnly(['payload'].concat(plaintextKeys))
        && data.payload is string;
    }

    // The Burn Week state on the profile is an encrypted payload string.
    function hasEncryptedRunState(data) {
      return isOptionalString(data, 'burn_week_run_state');
    }

    function canCreateBurnWeekRunStateProfile(uid, data) {
      return data.keys().hasOnly(['uid', 'burn_week_run_state'])
        && data.uid == uid
        && hasEncryptedRunState(data);
    }

    function isMissingOptionalStringValue(data, key) {
      return !(key in data)
        || data[key] == null
        || (data[key] is string && data[key].size() == 0);
    }

    function isMissingOptionalNumberValue(data, key) {
      return !(key in data) || data[key] == null;
    }

    function canFillMissingStringField(next, current, changed, key) {
      return !changed.hasAny([key])
        || (
          isMissingOptionalStringValue(current, key)
          && next[key] is string
          && next[key].size() > 0
        );
    }

    function canFillMissingNumberField(next, current, changed, key) {
      return !changed.hasAny([key])
        || (
          isMissingOptionalNumberValue(current, key)
          && next[key] is number
        );
    }

    function isAllowedGlobalFoodStatus(status) {
      return status in ['active', 'candidate', 'merged'];
    }

    function isAllowedNutritionQualityStatus(status) {
      return status in ['missing', 'unverified', 'verified'];
    }

    function nutritionQualityRank(status) {
      return status == 'verified'
        ? 2
        : status == 'unverified'
        ? 1
        : status == 'missing'
        ? 0
        : -1;
    }

    function isValidGlobalFoodNutrition(data) {
      return data.keys().hasOnly([
          'quality_status',
          'origin',
          'per_100_kcal',
          'per_100_protein',
          'per_100_carbs',
          'per_100_fat',
          'per_100_salt',
          'per_100_saturated_fat',
          'per_100_polyunsaturated_fat',
          'per_100_sugar',
          'per_100_fiber',
        ])
        && data.keys().hasAll(['quality_status'])
        && data.quality_status is string
        && isAllowedNutritionQualityStatus(data.quality_status)
        && (!('origin' in data) || data.origin in ['reported', 'estimated', 'unknown'])
        && isOptionalNumber(data, 'per_100_kcal')
        && isOptionalNumber(data, 'per_100_protein')
        && isOptionalNumber(data, 'per_100_carbs')
        && isOptionalNumber(data, 'per_100_fat')
        && isOptionalNumber(data, 'per_100_salt')
        && isOptionalNumber(data, 'per_100_saturated_fat')
        && isOptionalNumber(data, 'per_100_polyunsaturated_fat')
        && isOptionalNumber(data, 'per_100_sugar')
        && isOptionalNumber(data, 'per_100_fiber');
    }

    function isValidOptionalGlobalFoodNutrition(data, key) {
      return !(key in data)
        || data[key] == null
        || (
          data[key] is map
          && isValidGlobalFoodNutrition(data[key])
        );
    }

    function canPatchGlobalFoodNutrition(next, current) {
      let changed = next is map && current is map
        ? next.diff(current).affectedKeys()
        : null;
      return (
          next == null
          && current == null
        )
        || (
          current == null
          && next is map
          && isValidGlobalFoodNutrition(next)
        )
        || (
          next is map
          && current is map
          && isValidGlobalFoodNutrition(next)
          && changed.hasOnly([
            'quality_status',
            'origin',
            'per_100_kcal',
            'per_100_protein',
            'per_100_carbs',
            'per_100_fat',
            'per_100_salt',
            'per_100_saturated_fat',
            'per_100_polyunsaturated_fat',
            'per_100_sugar',
            'per_100_fiber',
          ])
          && (
            !changed.hasAny(['quality_status'])
            || nutritionQualityRank(next.quality_status)
              >= nutritionQualityRank(current.quality_status)
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_kcal'
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_protein'
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_carbs'
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_fat'
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_salt'
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_saturated_fat'
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_polyunsaturated_fat'
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_sugar'
          )
          && canFillMissingNumberField(
            next,
            current,
            changed,
            'per_100_fiber'
          )
        );
    }

    function isValidGlobalFoodItem(data, itemId) {
      return data.keys().hasOnly([
          'id',
          'food_fingerprint',
          'name',
          'brand',
          'category',
          'store_name',
          'barcode',
          'image_url',
          'package_weight',
          'serving_size',
          'serving_quantity',
          'serving_quantity_unit',
          'nutrition',
          'normalized_name',
          'normalized_brand',
          'normalized_store_name',
          'search_tokens',
          'status',
          'merged_into_id',
          'created_by_uid',
          'created_at',
          'updated_at',
        ])
        && data.keys().hasAll([
          'id',
          'food_fingerprint',
          'name',
          'normalized_name',
          'search_tokens',
          'status',
          'created_at',
          'updated_at',
        ])
        && data.id == itemId
        && data.id is string
        && data.food_fingerprint is string
        && data.food_fingerprint.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.normalized_name is string
        && data.normalized_name.size() > 0
        && data.search_tokens is list
        && data.search_tokens.size() > 0
        && data.status is string
        && isAllowedGlobalFoodStatus(data.status)
        && data.created_at is string
        && data.updated_at is string
        && isOptionalString(data, 'brand')
        && isOptionalString(data, 'category')
        && isOptionalString(data, 'store_name')
        && isOptionalString(data, 'barcode')
        && isOptionalString(data, 'image_url')
        && isOptionalString(data, 'package_weight')
        && isOptionalString(data, 'serving_size')
        && isOptionalNumber(data, 'serving_quantity')
        && isOptionalString(data, 'serving_quantity_unit')
        && isOptionalString(data, 'normalized_brand')
        && isOptionalString(data, 'normalized_store_name')
        && isOptionalString(data, 'merged_into_id')
        && isOptionalString(data, 'created_by_uid')
        && isValidOptionalGlobalFoodNutrition(data, 'nutrition');
    }

    function canPatchGlobalFoodItem(next, current, itemId) {
      let changed = next.diff(current).affectedKeys();
      return next.id == itemId
        && next.id == current.id
        && changed.hasOnly([
          'brand',
          'category',
          'store_name',
          'barcode',
          'image_url',
          'package_weight',
          'serving_size',
          'serving_quantity',
          'serving_quantity_unit',
          'normalized_brand',
          'normalized_store_name',
          'nutrition',
          'updated_at',
        ])
        && next.updated_at is string
        && canFillMissingStringField(next, current, changed, 'brand')
        && canFillMissingStringField(next, current, changed, 'category')
        && canFillMissingStringField(next, current, changed, 'store_name')
        && canFillMissingStringField(next, current, changed, 'barcode')
        && canFillMissingStringField(next, current, changed, 'image_url')
        && canFillMissingStringField(
          next,
          current,
          changed,
          'package_weight'
        )
        && canFillMissingStringField(next, current, changed, 'serving_size')
        && canFillMissingNumberField(
          next,
          current,
          changed,
          'serving_quantity'
        )
        && canFillMissingStringField(
          next,
          current,
          changed,
          'serving_quantity_unit'
        )
        && canFillMissingStringField(
          next,
          current,
          changed,
          'normalized_brand'
        )
        && canFillMissingStringField(
          next,
          current,
          changed,
          'normalized_store_name'
        )
        && (
          !changed.hasAny(['nutrition'])
          || canPatchGlobalFoodNutrition(next.nutrition, current.nutrition)
        );
    }

    function isValidGlobalBarcodeCandidate(data, candidateId) {
      return data.keys().hasOnly([
          'id',
          'barcode',
          'global_food_item_id',
          'selection_count',
          'unique_user_count',
          'completeness_score',
          'global_food_item',
          'created_by_uid',
          'created_at',
          'updated_at',
        ])
        && data.keys().hasAll([
          'id',
          'barcode',
          'global_food_item_id',
          'selection_count',
          'unique_user_count',
          'completeness_score',
          'global_food_item',
          'created_at',
          'updated_at',
        ])
        && data.id == candidateId
        && data.id is string
        && data.barcode is string
        && data.barcode.size() > 0
        && data.global_food_item_id is string
        && data.global_food_item_id.size() > 0
        && data.selection_count is int
        && data.selection_count > 0
        && data.unique_user_count is int
        && data.unique_user_count > 0
        && data.completeness_score is int
        && data.completeness_score >= 0
        && data.completeness_score <= 16
        && data.global_food_item is map
        && isValidGlobalFoodItem(
          data.global_food_item,
          data.global_food_item_id
        )
        && data.global_food_item.barcode == data.barcode
        && isOptionalString(data, 'created_by_uid')
        && data.created_at is string
        && data.updated_at is string;
    }

    function hasMatchingBarcodeCandidateVoteWrite(
      candidateId,
      next,
      current
    ) {
      let voteExistsBefore = exists(
        /databases/$(database)/documents/users/$(request.auth.uid)/global_barcode_candidate_votes/$(candidateId)
      );
      let voteExistsAfter = existsAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)/global_barcode_candidate_votes/$(candidateId)
      );
      let voteAfter = getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)/global_barcode_candidate_votes/$(candidateId)
      );

      return voteExistsAfter
        && voteAfter.data.barcode == next.barcode
        && voteAfter.data.global_food_item_id == next.global_food_item_id
        && voteAfter.data.candidate_id == candidateId
        && voteAfter.data.updated_at == next.updated_at
        && (
          (!voteExistsBefore
            && next.unique_user_count == current.unique_user_count + 1)
          || (voteExistsBefore
            && next.unique_user_count == current.unique_user_count
            && voteAfter.data.updated_at
              != get(
                /databases/$(database)/documents/users/$(request.auth.uid)/global_barcode_candidate_votes/$(candidateId)
              ).data.updated_at)
        );
    }

    function isBarcodeCandidateVoteUpdate(candidateId, next, current) {
      return next.diff(current).affectedKeys().hasOnly([
          'selection_count',
          'unique_user_count',
          'updated_at',
        ])
        && next.selection_count is int
        && next.unique_user_count is int
        && next.updated_at is string
        && next.selection_count == current.selection_count + 1
        && hasMatchingBarcodeCandidateVoteWrite(
          candidateId,
          next,
          current
        );
    }

    function isValidUserBarcodeCandidateVote(data, candidateId) {
      return data.keys().hasOnly([
          'barcode',
          'global_food_item_id',
          'candidate_id',
          'created_at',
          'updated_at',
        ])
        && data.keys().hasAll([
          'barcode',
          'global_food_item_id',
          'candidate_id',
          'created_at',
          'updated_at',
        ])
        && data.barcode is string
        && data.barcode.size() > 0
        && data.global_food_item_id is string
        && data.global_food_item_id.size() > 0
        && data.candidate_id == candidateId
        && data.created_at is string
        && data.updated_at is string;
    }

    function isValidGlobalFoodReceiptAlias(data, aliasId) {
      return data.keys().hasOnly([
          'id',
          'global_food_item_id',
          'store_name',
          'normalized_store_name',
          'receipt_name',
          'normalized_receipt_name',
          'compact_receipt_name',
          'receipt_search_tokens',
          'lookup_key',
          'selection_count',
          'unique_user_count',
          'global_food_item',
          'created_by_uid',
          'created_at',
          'updated_at',
        ])
        && data.keys().hasAll([
          'id',
          'global_food_item_id',
          'store_name',
          'normalized_store_name',
          'receipt_name',
          'normalized_receipt_name',
          'compact_receipt_name',
          'receipt_search_tokens',
          'lookup_key',
          'selection_count',
          'global_food_item',
          'created_at',
          'updated_at',
        ])
        && data.id == aliasId
        && data.id is string
        && data.global_food_item_id is string
        && data.store_name is string
        && data.normalized_store_name is string
        && data.receipt_name is string
        && data.normalized_receipt_name is string
        && data.compact_receipt_name is string
        && data.receipt_search_tokens is list
        && data.lookup_key is string
        && data.lookup_key.size() > 0
        && isOptionalString(data, 'created_by_uid')
        && data.selection_count is int
        && data.selection_count > 0
        && (!('unique_user_count' in data)
          || (data.unique_user_count is int && data.unique_user_count > 0))
        && data.global_food_item is map
        && isValidGlobalFoodItem(
          data.global_food_item,
          data.global_food_item_id
        )
        && data.created_at is string
        && data.updated_at is string;
    }

    // Saving an alias again adds one save, and one user only when that
    // user's first vote is written in the same batch. The author of an
    // alias from before the votes already counts as its one user. Only the
    // counters and the time change, so the rule stays cheap.
    function isReceiptAliasSaveUpdate(aliasId, next, current) {
      let votePath = /databases/$(database)/documents/users/$(request.auth.uid)/global_food_item_receipt_alias_votes/$(aliasId);
      let currentUsers = current.get('unique_user_count', 1);
      return next.diff(current).affectedKeys().hasOnly([
          'selection_count',
          'unique_user_count',
          'updated_at',
        ])
        && next.selection_count == current.selection_count + 1
        && next.updated_at is string
        && next.unique_user_count is int
        && (
          next.unique_user_count == currentUsers
          || (next.unique_user_count == currentUsers + 1
            && !exists(votePath)
            && existsAfter(votePath)
            && current.get('created_by_uid', null) != request.auth.uid)
        );
    }

    function isValidUserReceiptAliasVote(data, aliasId) {
      return data.keys().hasOnly([
          'alias_id',
          'lookup_key',
          'global_food_item_id',
          'created_at',
          'updated_at',
        ])
        && data.alias_id == aliasId
        && data.lookup_key is string
        && data.global_food_item_id is string
        && data.created_at is string
        && data.updated_at is string;
    }

    // A new global catalog document records its author.
    function isCreatedByCurrentUser(data) {
      return data.get('created_by_uid', null) == request.auth.uid;
    }

    // An update keeps the author, also when an older document has none.
    function keepsAuthor(next, current) {
      return next.get('created_by_uid', null)
        == current.get('created_by_uid', null);
    }

    function isAllowedServingSuggestionUnit(unit) {
      return unit in ['g', 'ml'];
    }

    function isValidGlobalFoodServingSuggestion(data, suggestionId) {
      return data.keys().hasOnly([
          'id',
          'item_key',
          'global_food_item_id',
          'food_fingerprint',
          'amount',
          'unit',
          'label',
          'selection_count',
          'unique_user_count',
          'created_by_uid',
          'created_at',
          'updated_at',
        ])
        && data.keys().hasAll([
          'id',
          'item_key',
          'amount',
          'unit',
          'selection_count',
          'unique_user_count',
          'created_at',
          'updated_at',
        ])
        && data.id == suggestionId
        && data.id is string
        && data.item_key is string
        && data.item_key.size() > 0
        && isOptionalString(data, 'global_food_item_id')
        && isOptionalString(data, 'food_fingerprint')
        && (
          (
            data.global_food_item_id is string
            && data.global_food_item_id.size() > 0
            && exists(
              /databases/$(database)/documents/global_food_items/$(data.global_food_item_id)
            )
          )
          || (
            data.food_fingerprint is string
            && data.food_fingerprint.size() > 0
          )
        )
        && data.amount is number
        && data.amount > 0
        && data.unit is string
        && isAllowedServingSuggestionUnit(data.unit)
        && isOptionalString(data, 'label')
        && isOptionalString(data, 'created_by_uid')
        && data.selection_count is int
        && data.selection_count > 0
        && data.unique_user_count is int
        && data.unique_user_count > 0
        && data.created_at is string
        && data.updated_at is string;
    }

    function isValidUserServingPreference(data, itemKey) {
      return data.keys().hasOnly([
          'item_key',
          'global_food_item_id',
          'food_fingerprint',
          'amount',
          'unit',
          'label',
          'updated_at',
        ])
        && data.keys().hasAll([
          'item_key',
          'food_fingerprint',
          'amount',
          'unit',
          'updated_at',
        ])
        && data.item_key == itemKey
        && data.item_key is string
        && data.food_fingerprint is string
        && data.food_fingerprint.size() > 0
        && data.amount is number
        && data.amount > 0
        && data.unit is string
        && isAllowedServingSuggestionUnit(data.unit)
        && data.updated_at is string
        && isOptionalString(data, 'global_food_item_id')
        && isOptionalString(data, 'label');
    }

    function isValidUserServingVote(data, suggestionId) {
      return data.keys().hasOnly([
          'item_key',
          'suggestion_id',
          'global_food_item_id',
          'food_fingerprint',
          'amount',
          'unit',
          'created_at',
          'updated_at',
        ])
        && data.keys().hasAll([
          'item_key',
          'suggestion_id',
          'amount',
          'unit',
          'created_at',
          'updated_at',
        ])
        && data.suggestion_id == suggestionId
        && data.item_key is string
        && data.item_key.size() > 0
        && isOptionalString(data, 'global_food_item_id')
        && isOptionalString(data, 'food_fingerprint')
        && (
          (
            data.global_food_item_id is string
            && data.global_food_item_id.size() > 0
          )
          || (
            data.food_fingerprint is string
            && data.food_fingerprint.size() > 0
          )
        )
        && data.amount is number
        && data.amount > 0
        && data.unit is string
        && isAllowedServingSuggestionUnit(data.unit)
        && data.created_at is string
        && data.updated_at is string;
    }

    // Minimum and latest app version. Only the release writes it, with
    // admin access; every client reads it, also signed out.
    match /config/app_version {
      allow read: if true;
      allow write: if false;
    }

    match /calorie_product_catalog/{barcode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /off_products/{barcode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /food_fingerprint_catalog/{fingerprint} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /global_food_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/global_food_items/$(itemId))
        && isValidGlobalFoodItem(request.resource.data, itemId)
        && isCreatedByCurrentUser(request.resource.data);
      allow update: if isSignedIn()
        && canPatchGlobalFoodItem(
          request.resource.data,
          resource.data,
          itemId
        );
      allow delete: if false;
    }

    match /global_barcode_candidates/{candidateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(
          /databases/$(database)/documents/global_barcode_candidates/$(candidateId)
        )
        && isValidGlobalBarcodeCandidate(request.resource.data, candidateId)
        && isCreatedByCurrentUser(request.resource.data);
      allow update: if isSignedIn()
        && isBarcodeCandidateVoteUpdate(
          candidateId,
          request.resource.data,
          resource.data
        );
      allow delete: if false;
    }

    match /global_food_item_receipt_aliases/{aliasId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidGlobalFoodReceiptAlias(request.resource.data, aliasId)
        && isCreatedByCurrentUser(request.resource.data)
        && request.resource.data.selection_count == 1
        && request.resource.data.get('unique_user_count', 1) == 1;
      allow update: if isSignedIn()
        && keepsAuthor(request.resource.data, resource.data)
        && isReceiptAliasSaveUpdate(
          aliasId,
          request.resource.data,
          resource.data
        );
      allow delete: if false;
    }

    match /global_food_item_serving_sizes/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(
          /databases/$(database)/documents/global_food_item_serving_sizes/$(suggestionId)
        )
        && isValidGlobalFoodServingSuggestion(
          request.resource.data,
          suggestionId
        )
        && isCreatedByCurrentUser(request.resource.data);
      allow update: if isSignedIn()
        && isValidGlobalFoodServingSuggestion(
          request.resource.data,
          suggestionId
        )
        && request.resource.data.id == resource.data.id
        && request.resource.data.item_key == resource.data.item_key
        && request.resource.data.get('global_food_item_id', null)
          == resource.data.get('global_food_item_id', null)
        && request.resource.data.get('food_fingerprint', null)
          == resource.data.get('food_fingerprint', null)
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.get('label', null)
          == resource.data.get('label', null)
        && keepsAuthor(request.resource.data, resource.data)
        && request.resource.data.selection_count
          == resource.data.selection_count + 1
        && request.resource.data.unique_user_count >= resource.data.unique_user_count
        && request.resource.data.unique_user_count
          <= resource.data.unique_user_count + 1;
      allow delete: if false;
    }

    // Only the admin invites. The invite holds the household key wrapped
    // with a secret that only the QR code or link carries. Nobody lists the
    // invites: a joining user reads one by its code.
    // The id is random and too long to guess: only the QR code or link
    // carries it.
    match /household_invites/{code} {
      allow get: if isSignedIn();
      allow create: if isVerifiedAccount()
        && code.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly([
          'householdId',
          'expiresAt',
          'wrapped_household_key',
        ])
        && request.resource.data.householdId is string
        && isHouseholdAdmin(request.resource.data.householdId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h')
        && request.resource.data.wrapped_household_key is string;
      allow delete: if isVerifiedAccount()
        && isHouseholdAdmin(resource.data.householdId);
      // The user who joins with the invite uses it up in the same write.
      allow delete: if isSignedIn()
        && !exists(memberPath(resource.data.householdId, request.auth.uid))
        && getAfter(memberPath(resource.data.householdId, request.auth.uid))
          .data.get('invite_code', null) == code;
    }

    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      // A user creates a household together with their admin entry.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['created_at'])
        && request.resource.data.created_at == request.time
        && getAfter(memberPath(householdId, request.auth.uid)).data.role == 'admin';
      // Rules cannot count the members, so no client deletes a household.
      // The Cloud Function repairHouseholdOnMemberChange deletes it once the
      // last member left, and names a new admin when none is left.
      allow delete: if false;

      match /members/{uid} {
        allow read: if isHouseholdMember(householdId) || isOwner(uid);
        // The creator of a new household becomes its admin.
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'joined_at'])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'admin'
          && request.resource.data.joined_at == request.time
          && !exists(householdPath(householdId))
          && existsAfter(householdPath(householdId));
        // Everybody else joins as a member with a valid invite, which the
        // join uses up: a removed member cannot come back with it.
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'uid',
            'role',
            'joined_at',
            'invite_code',
          ])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'member'
          && request.resource.data.joined_at == request.time
          && request.resource.data.invite_code is string
          && isValidInvite(request.resource.data.invite_code, householdId)
          && !existsAfter(invitePath(request.resource.data.invite_code))
          && exists(householdPath(householdId));
        // Only the admin changes roles. Whoever becomes admin replaces the
        // admin in the same write: the admin turns member or leaves.
        allow update: if isHouseholdAdmin(householdId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role'])
          && request.resource.data.role in ['admin', 'member']
          && (
            request.resource.data.role == 'member'
            || !existsAfter(memberPath(householdId, request.auth.uid))
            || getAfter(memberPath(householdId, request.auth.uid)).data.role
              == 'member'
          );
        // A member leaves, the admin removes members.
        allow delete: if isOwner(uid) || isHouseholdAdmin(householdId);
      }

      // The household key, wrapped with the data key of one member. Only
      // that member opens it. The admin deletes it to remove the member.
      match /keys/{uid} {
        allow read: if isOwner(uid) && isHouseholdMember(householdId);
        allow create, update: if isOwner(uid)
          && isHouseholdMemberAfter(householdId)
          && request.resource.data.keys().hasOnly(['wrapped_key'])
          && request.resource.data.wrapped_key is string;
        allow delete: if isOwner(uid) || isHouseholdAdmin(householdId);
      }

      // A member who started fresh asks the others for the household key.
      // Another member answers with the key wrapped by a one-time code.
      match /key_restores/{uid} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isOwner(uid)
          && isHouseholdMember(householdId)
          && request.resource.data.keys().size() == 0;
        allow update: if isHouseholdMember(householdId)
          && !isOwner(uid)
          && request.resource.data.keys().hasOnly(['wrapped_household_key'])
          && request.resource.data.wrapped_household_key is string;
        allow delete: if isOwner(uid) || isHouseholdAdmin(householdId);
      }

      match /inventory_items/{itemId} {
        allow read, delete: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && isEncryptedDocument(request.resource.data, ['entry_date', 'origin', 'is_deposit', 'is_discount']);
      }

      match /shopping_list_items/{itemId} {
        allow read, delete: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && isEncryptedDocument(request.resource.data, []);
      }

      match /prepared_meals/{mealId} {
        allow read, delete: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && isEncryptedDocument(request.resource.data, []);
      }

      match /prepared_meal_templates/{templateId} {
        allow read, delete: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && isEncryptedDocument(request.resource.data, []);
      }

      match /kitchen_utensils/{utensilId} {
        allow read, delete: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && isEncryptedDocument(request.resource.data, []);
      }

      match /inventory_discard_events/{eventId} {
        allow read, delete: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && isEncryptedDocument(request.resource.data, ['discarded_at']);
      }

      // Events are append-only; the admin deletes them with the household.
      match /inventory_activity_events/{eventId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && isEncryptedDocument(request.resource.data, ['happened_at']);
        allow delete: if isHouseholdAdmin(householdId);
      }
    }

    match /users/{uid} {
      allow read: if canReadUserDocument(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && hasEncryptedRunState(request.resource.data);
      allow create: if isOwner(uid)
        && canCreateBurnWeekRunStateProfile(uid, request.resource.data);
      allow update: if (isOwner(uid)
          && request.resource.data.uid == uid
          && hasEncryptedRunState(request.resource.data))
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['burn_week_run_state'])
          && hasEncryptedRunState(request.resource.data));
      allow delete: if isOwner(uid);
    }

    // App version of each device, so a release can count old devices before
    // it removes a migration. Plaintext: version and platform are no health
    // data.
    match /users/{uid}/clients/{installId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys()
          .hasOnly(['app_version', 'platform', 'last_seen_at'])
        && request.resource.data.app_version is string
        && request.resource.data.app_version.size() <= 32
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 16
        && request.resource.data.last_seen_at is timestamp;
    }

    // Backup of the data key, wrapped with the recovery key of the user.
    match /users/{uid}/private/data_key {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['wrapped_key'])
        && request.resource.data.wrapped_key is string;
    }

    match /users/{uid}/calorie_entries/{entryId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isEncryptedDocument(request.resource.data, ['logged_at'])
        && request.resource.data.logged_at is timestamp;
    }

    // Planned food, kept apart from the calorie entries so no sum counts it.
    match /users/{uid}/planned_entries/{entryId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isEncryptedDocument(request.resource.data, ['logged_at'])
        && request.resource.data.logged_at is timestamp;
    }

    match /users/{uid}/calorie_settings/{settingsId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isEncryptedDocument(request.resource.data, []);
    }

    match /users/{uid}/health_weights/{weightId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isEncryptedDocument(request.resource.data, []);
    }

    match /users/{uid}/calorie_product_overrides/{barcode} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isEncryptedDocument(request.resource.data, []);
    }

    match /users/{uid}/global_food_item_serving_prefs/{itemKey} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isValidUserServingPreference(request.resource.data, itemKey);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/global_food_item_serving_votes/{suggestionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUserServingVote(request.resource.data, suggestionId);
      allow update: if isOwner(uid)
        && isValidUserServingVote(request.resource.data, suggestionId)
        && request.resource.data.item_key == resource.data.item_key
        && request.resource.data.suggestion_id == resource.data.suggestion_id
        && request.resource.data.get('global_food_item_id', null)
          == resource.data.get('global_food_item_id', null)
        && request.resource.data.get('food_fingerprint', null)
          == resource.data.get('food_fingerprint', null)
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/global_barcode_candidate_votes/{candidateId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUserBarcodeCandidateVote(
          request.resource.data,
          candidateId
        );
      allow update: if isOwner(uid)
        && isValidUserBarcodeCandidateVote(
          request.resource.data,
          candidateId
        )
        && request.resource.data.barcode == resource.data.barcode
        && request.resource.data.global_food_item_id
          == resource.data.global_food_item_id
        && request.resource.data.candidate_id == resource.data.candidate_id
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isOwner(uid);
    }

    // One vote per user and alias. No delete: a deleted vote could be
    // written again and count the same user twice.
    match /users/{uid}/global_food_item_receipt_alias_votes/{aliasId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUserReceiptAliasVote(request.resource.data, aliasId);
      allow update: if isOwner(uid)
        && isValidUserReceiptAliasVote(request.resource.data, aliasId)
        && request.resource.data.lookup_key == resource.data.lookup_key
        && request.resource.data.global_food_item_id
          == resource.data.global_food_item_id
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;
    }

    // TODO: Replace this generic owner-based rule once all collection
    // schemas are stable and covered with explicit rules.
    // config/ holds documents that only the release writes; the userId rule
    // below must not open them.
    match /{document=**} {
      allow create: if isSignedIn()
        && isOutsideHouseholds(document)
        && document[0] != 'config'
        && 'userId' in request.resource.data
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && isOutsideHouseholds(document)
        && document[0] != 'config'
        && 'userId' in resource.data
        && resource.data.userId == request.auth.uid;
    }
  }
}
