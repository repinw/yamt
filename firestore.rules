rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerifiedAccount() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userHouseholdId(uid) {
      return userExists(uid)
        && get(/databases/$(database)/documents/users/$(uid))
          .data.householdId is string
        ? get(/databases/$(database)/documents/users/$(uid))
            .data.householdId
        : null;
    }

    function householdOwnerId(uid) {
      let householdId = userHouseholdId(uid);
      return householdId == null ? uid : householdId;
    }

    function currentHouseholdOwnerId() {
      return householdOwnerId(request.auth.uid);
    }

    function resourceHouseholdId() {
      return resource != null
        && resource.data.householdId is string
        ? resource.data.householdId
        : null;
    }

    function canAccessHouseholdOwnedData(uid) {
      return isSignedIn()
        && (
          request.auth.uid == uid
          || currentHouseholdOwnerId() == uid
        );
    }

    function canReadUserDocument(uid) {
      let householdOwnerId = currentHouseholdOwnerId();
      return isSignedIn()
        && (
          uid == request.auth.uid
          || uid == householdOwnerId
          || resourceHouseholdId() == householdOwnerId
        );
    }

    function canRemoveHouseholdMember(uid) {
      return isVerifiedAccount()
        && uid != request.auth.uid
        && resource.data.householdId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['householdId'])
        && !('householdId' in request.resource.data);
    }

    function isOptionalString(data, key) {
      return !(key in data) || data[key] == null || data[key] is string;
    }

    function isOptionalMap(data, key) {
      return !(key in data) || data[key] == null || data[key] is map;
    }

    function isAllowedGlobalFoodStatus(status) {
      return status in ['active', 'candidate', 'merged'];
    }

    function isValidGlobalFoodItem(data, itemId) {
      return data.keys().hasOnly([
          'id',
          'food_fingerprint',
          'name',
          'brand',
          'category',
          'barcode',
          'image_url',
          'package_weight',
          'nutrition',
          'normalized_name',
          'normalized_brand',
          'search_tokens',
          'status',
          'merged_into_id',
          'created_at',
          'updated_at',
        ])
        && data.keys().hasAll([
          'id',
          'food_fingerprint',
          'name',
          'normalized_name',
          'search_tokens',
          'status',
          'created_at',
          'updated_at',
        ])
        && data.id == itemId
        && data.id is string
        && data.food_fingerprint is string
        && data.food_fingerprint.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.normalized_name is string
        && data.normalized_name.size() > 0
        && data.search_tokens is list
        && data.search_tokens.size() > 0
        && data.status is string
        && isAllowedGlobalFoodStatus(data.status)
        && data.created_at is string
        && data.updated_at is string
        && isOptionalString(data, 'brand')
        && isOptionalString(data, 'category')
        && isOptionalString(data, 'barcode')
        && isOptionalString(data, 'image_url')
        && isOptionalString(data, 'package_weight')
        && isOptionalString(data, 'normalized_brand')
        && isOptionalString(data, 'merged_into_id')
        && isOptionalMap(data, 'nutrition');
    }

    function isAllowedCalorieSource(source) {
      return source in [
        'user_override',
        'global_catalog',
        'off_barcode',
        'off_search',
        'ocr',
      ];
    }

    function isValidCalorieProductCore(data) {
      return data.keys().hasAll([
          'barcode',
          'name',
          'per100_kcal',
          'per100_protein',
          'per100_carbs',
          'per100_fat',
          'source',
          'created_at',
          'updated_at',
        ])
        && data.barcode is string
        && data.name is string
        && data.per100_kcal is number
        && data.per100_protein is number
        && data.per100_carbs is number
        && data.per100_fat is number
        && data.created_at is timestamp
        && data.updated_at is timestamp
        && data.source is string
        && isAllowedCalorieSource(data.source)
        && isOptionalString(data, 'brand')
        && isOptionalString(data, 'image_url')
        && isOptionalString(data, 'off_product_id');
    }

    match /calorie_product_catalog/{barcode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /off_products/{barcode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /food_fingerprint_catalog/{fingerprint} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /barcode_enrichment_jobs/{fingerprint} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /global_food_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/global_food_items/$(itemId))
        && isValidGlobalFoodItem(request.resource.data, itemId);
      allow update: if false;
      allow delete: if false;
    }

    match /household_invites/{code} {
      allow read: if isSignedIn();
      allow create, update: if isVerifiedAccount()
        && request.resource.data.keys().hasOnly([
          'hostUid',
          'expiresAt',
        ])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.expiresAt is timestamp;
      allow delete: if isVerifiedAccount()
        && resource.data.hostUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if canReadUserDocument(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid;
      allow update: if (isOwner(uid) && request.resource.data.uid == uid)
        || canRemoveHouseholdMember(uid);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/inventory_items/{itemId} {
      allow read, create, update, delete: if canAccessHouseholdOwnedData(uid);
    }

    match /users/{uid}/shopping_list_items/{itemId} {
      allow read, create, update, delete: if canAccessHouseholdOwnedData(uid);
    }

    match /users/{uid}/prepared_meals/{mealId} {
      allow read, create, update, delete: if canAccessHouseholdOwnedData(uid);
    }

    match /users/{uid}/prepared_meal_templates/{templateId} {
      allow read, create, update, delete: if canAccessHouseholdOwnedData(uid);
    }

    match /users/{uid}/inventory_discard_events/{eventId} {
      allow read, create, update, delete: if canAccessHouseholdOwnedData(uid);
    }

    match /users/{uid}/calorie_entries/{entryId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/calorie_settings/{settingsId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/calorie_product_overrides/{barcode} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'barcode',
          'name',
          'brand',
          'image_url',
          'per100_kcal',
          'per100_protein',
          'per100_carbs',
          'per100_fat',
          'source',
          'off_product_id',
          'created_at',
          'updated_at',
          'user_id',
          'reason',
        ])
        && request.resource.data.barcode == barcode
        && request.resource.data.user_id == uid
        && request.resource.data.reason is string
        && request.resource.data.source == 'user_override'
        && isValidCalorieProductCore(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/barcode_enrichment_requests/{fingerprint} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'user_id',
          'fingerprint',
          'item_name',
          'brand',
          'trigger',
          'status',
          'requested_at',
          'updated_at',
          'priority',
          'provided_barcode',
          'force_retry',
        ])
        && request.resource.data.user_id == uid
        && request.resource.data.fingerprint == fingerprint
        && request.resource.data.item_name is string
        && isOptionalString(request.resource.data, 'brand')
        && request.resource.data.trigger is string
        && request.resource.data.status is string
        && request.resource.data.requested_at is timestamp
        && request.resource.data.updated_at is timestamp
        && (!( 'priority' in request.resource.data) ||
            request.resource.data.priority is string)
        && (!( 'provided_barcode' in request.resource.data) ||
            request.resource.data.provided_barcode is string)
        && (!( 'force_retry' in request.resource.data) ||
            request.resource.data.force_retry is bool);
      allow delete: if false;
    }

    // TODO: Replace this generic owner-based rule once all collection
    // schemas are stable and covered with explicit rules.
    match /{document=**} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
